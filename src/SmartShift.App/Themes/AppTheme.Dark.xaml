<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ZUNO Modern Light & Berry Rose (#CC4778) Design System -->
    <Color x:Key="WindowBgColor">#F8F9FA</Color>
    <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource WindowBgColor}" />

    <LinearGradientBrush x:Key="WindowBgGradient" StartPoint="0.12,0" EndPoint="0.92,1">
        <GradientStop Color="#FFF7FA" Offset="0" />
        <GradientStop Color="#F7F4F8" Offset="0.42" />
        <GradientStop Color="#EEF2F7" Offset="1" />
    </LinearGradientBrush>

    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />

    <Color x:Key="SurfaceAltColor">#F8F9FA</Color>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />

    <Color x:Key="SurfaceElevatedColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />

    <!-- Modern Clean Card & Panel Surfaces -->
    <SolidColorBrush x:Key="GlassPanelBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="GlassCardBrush" Color="#FFFFFF" />

    <LinearGradientBrush x:Key="GlassCardHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#FDF5F8" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassCardSelectedBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FDF2F6" Offset="0" />
        <GradientStop Color="#FCE8EF" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="GlassSidebarBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />

    <Color x:Key="BorderColor">#E5E7EB</Color>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

    <Color x:Key="BorderLightColor">#F1F3F5</Color>
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}" />

    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#F8F9FA" />

    <!-- ZUNO Signature Brand Colors (#CC4778) -->
    <Color x:Key="AccentColor">#CC4778</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#FDF0F5" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#33CC4778" />

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#CC4778" Offset="0" />
        <GradientStop Color="#E05A8B" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RadialActiveGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#CC4778" Offset="0" />
        <GradientStop Color="#B83866" Offset="1" />
    </LinearGradientBrush>

    <!-- Semantic Feedback Colors -->
    <Color x:Key="OkColor">#10B981</Color>
    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}" />
    <SolidColorBrush x:Key="OkSoftBrush" Color="#ECFDF5" />
    <SolidColorBrush x:Key="OkBgBrush" Color="#F0FDF4" />

    <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#10B981" Offset="0" />
        <GradientStop Color="#059669" Offset="1" />
    </LinearGradientBrush>

    <Color x:Key="WarnColor">#F59E0B</Color>
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#FEF3C7" />
    <SolidColorBrush x:Key="WarnBgBrush" Color="#FFFBEB" />

    <Color x:Key="DangerColor">#EF4444</Color>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FEE2E2" />
    <SolidColorBrush x:Key="DangerBgBrush" Color="#FEF2F2" />

    <!-- Typography -->
    <SolidColorBrush x:Key="TextBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="MutedBrush" Color="#64748B" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#94A3B8" />
</ResourceDictionary>
